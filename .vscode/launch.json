{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AtCoder: Debug Test (oj)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/debug_test.py",
      "args": ["${fileDirname}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "subProcess": true
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "subProcess": true
    }
  ]
}
